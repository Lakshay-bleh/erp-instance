# Backend API base URL (no trailing slash). Frontend calls BASE/incidents, BASE/incidents/:id, etc.
#
# --- Local dev ---
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# --- Vercel (recommended: proxy to avoid CORS) ---
# On the FRONTEND Vercel project, set:
#   API_PROXY_TARGET=https://erp-incidents-api.vercel.app   (backend URL, NO /api)
#   NEXT_PUBLIC_API_URL = (leave empty or delete)
# Then the client uses same-origin /api and rewrites proxy to the backend. See docs/CORS_FIX_VERCEL.md
#
# --- Vercel (direct backend = needs CORS on backend) ---
# NEXT_PUBLIC_API_URL=https://erp-incidents-api.vercel.app/api
