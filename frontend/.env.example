# Backend API base URL (no trailing slash). Frontend calls BASE/incidents, BASE/incidents/:id, etc.
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Vercel backend (must include /api): https://your-backend-project.vercel.app/api
# Railway/Render/Fly (root): https://your-api.up.railway.app
#
# Optional: Proxy backend through frontend (avoids CORS). On Vercel frontend project:
# - Set API_PROXY_TARGET=https://your-backend.vercel.app (no /api)
# - Leave NEXT_PUBLIC_API_URL unset so the client uses /api (same-origin)
