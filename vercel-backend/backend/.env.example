# Local vs AWS: use in-memory/local store (true) or real DynamoDB/S3 (false)
USE_LOCAL_AWS=true
USE_MEMORY_STORE=true

# When using real AWS, set to true to run enrichment in Lambda instead of FastAPI
USE_LAMBDA_ENRICHMENT=false

# AWS (when USE_MEMORY_STORE=false)
AWS_REGION=us-east-1
DYNAMODB_TABLE=erp-incidents
S3_BUCKET=erp-incidents-payloads
LAMBDA_FUNCTION_NAME=erp-incident-enrichment

# Groq (for AI summary + suggested action)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# When backend is deployed separately: frontend URL(s), comma-separated (for CORS)
# CORS_ORIGINS_EXTRA=https://your-app.vercel.app
