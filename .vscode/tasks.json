{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": {} },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": {} },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "backend: run",
      "type": "shell",
      "command": ".venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
      "windows": {
        "command": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"
      },
      "options": { "cwd": "${workspaceFolder}/backend", "env": {} },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
